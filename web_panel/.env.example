# LEGIONFORGE :: веб-панель. Скопируйте в .env и укажите свои значения.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Необязательно: живой мост к игровой MySQL (auth/characters/world/hotfixes).
# Если задано - tools/mysql-bridge.mjs синхронизирует онлайн, аккаунты и валюту
# в хранилище панели каждые N секунд.
LEGIONFORGE_MYSQL_HOST=127.0.0.1
LEGIONFORGE_MYSQL_PORT=3306
LEGIONFORGE_MYSQL_USER=root
LEGIONFORGE_MYSQL_PASSWORD=legionforge
LEGIONFORGE_MYSQL_DB_AUTH=legionforge_auth
LEGIONFORGE_MYSQL_DB_CHARACTERS=legionforge_characters
LEGIONFORGE_MYSQL_DB_WORLD=legionforge_world
LEGIONFORGE_SYNC_INTERVAL=15
